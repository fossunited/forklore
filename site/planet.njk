---
layout: base.njk
title: Planet Forklore
description: Aggregated blog posts from India's open source maintainers.
pagination:
  data: planet.posts
  size: 10
  alias: pagePosts
permalink: "/planet/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<section class="planet-hero">
  <h1>Planet Forklore</h1>
  <p>Aggregated blog posts from India's open source maintainers.</p>
  <div class="planet-stats">
    <span>{{ planet.authors.length }} maintainers</span>
    <span>·</span>
    <span>{{ planet.totalPosts }} posts</span>
  </div>
  <a href="/planet/rss.xml" class="button solid">Subscribe to RSS</a>
</section>

<section class="planet-controls" aria-label="Planet filters">
  <label class="search-box planet-search">
    <span aria-hidden="true">⌕</span>
    <input data-planet-search type="search" placeholder="Search posts" autocomplete="off">
  </label>
  <details>
    <summary>Filter by author or tag</summary>
    <div class="planet-filter-group">
      <h2>By Author</h2>
      <div class="planet-filter-list">
        {% for author in planet.authors %}
          <a href="/planet/{{ author.username }}/" class="button subtle">
            <img src="{{ author.photo or '/maintainer_photo_light.svg' }}" alt="" class="avatar tiny">
            {{ author.name }}
          </a>
        {% endfor %}
      </div>
    </div>
    <div class="planet-filter-group">
      <h2>By Tag</h2>
      <div class="planet-filter-list">
        {% for tag in planet.tags %}
          <button class="button subtle" type="button" data-planet-tag="{{ tag.name }}">{{ tag.name }} <span>({{ tag.count }})</span></button>
        {% endfor %}
      </div>
    </div>
  </details>
</section>

<section class="planet-posts" aria-label="Planet posts">
  {% for post in pagePosts %}
    {% include "planet-post-card.njk" %}
  {% endfor %}
  <p class="empty-state" data-planet-empty hidden>No posts found</p>
</section>

{% if pagination.href.previous or pagination.href.next %}
<nav class="planet-pagination" aria-label="Page navigation">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="button subtle">← Newer</a>
  {% else %}
    <span class="button subtle" aria-disabled="true">← Newer</span>
  {% endif %}
  <span class="planet-page-count">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="button subtle">Older →</a>
  {% else %}
    <span class="button subtle" aria-disabled="true">Older →</span>
  {% endif %}
</nav>
{% endif %}
